{
  "description": "DevSpec remote-control turn mirroring + work-trail (UserPromptSubmit/Stop + mid-turn tool hooks). The extension also merges a fragment into ~/.cursor/hooks.json on activate.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/mirror-turn.mjs\" stop",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/mirror-turn.mjs\" user_prompt",
            "timeout": 30
          }
        ]
      }
    ],
    "postToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/trail-turn.mjs\" postToolUse",
            "timeout": 30
          }
        ]
      }
    ],
    "postToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/trail-turn.mjs\" postToolUseFailure",
            "timeout": 30
          }
        ]
      }
    ],
    "afterShellExecution": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/trail-turn.mjs\" afterShellExecution",
            "timeout": 30
          }
        ]
      }
    ],
    "beforeShellExecution": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/trail-turn.mjs\" beforeShellExecution",
            "timeout": 30
          }
        ]
      }
    ],
    "afterMCPExecution": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/trail-turn.mjs\" afterMCPExecution",
            "timeout": 30
          }
        ]
      }
    ],
    "beforeMCPExecution": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/trail-turn.mjs\" beforeMCPExecution",
            "timeout": 30
          }
        ]
      }
    ],
    "afterFileEdit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/trail-turn.mjs\" afterFileEdit",
            "timeout": 30
          }
        ]
      }
    ],
    "afterAgentThought": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/trail-turn.mjs\" afterAgentThought",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
