{
  "name": "devspec-autopilot",
  "displayName": "DevSpec Autopilot",
  "description": "Connect Cursor's AI agent to DevSpec — pick up action items, run autopilot, brainstorm scope, and ship work without leaving the editor.",
  "version": "0.4.5",
  "publisher": "devspecai",
  "license": "MIT",
  "author": {
    "name": "DevSpecAI",
    "email": "hello@devspec.ai",
    "url": "https://devspec.ai"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DevSpecAI/cursor-devspec-plugin"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "devspec",
    "autopilot",
    "mcp",
    "ai",
    "agent",
    "project-management"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onUri",
    "onStartupFinished",
    "onCommand:devspec.installProjectRules"
  ],
  "contributes": {
    "commands": [
      {
        "command": "devspec.work",
        "title": "DevSpec: Work on action item",
        "category": "DevSpec"
      },
      {
        "command": "devspec.brainstorm",
        "title": "DevSpec: Brainstorm action item",
        "category": "DevSpec"
      },
      {
        "command": "devspec.create",
        "title": "DevSpec: Create action item",
        "category": "DevSpec"
      },
      {
        "command": "devspec.session-brainstorm",
        "title": "DevSpec: Continue session in local agent",
        "category": "DevSpec"
      },
      {
        "command": "devspec.remote",
        "title": "DevSpec: Connect remote control",
        "category": "DevSpec"
      },
      {
        "command": "devspec.remote-stop",
        "title": "DevSpec: Disconnect remote control",
        "category": "DevSpec"
      },
      {
        "command": "devspec.verify-connection",
        "title": "DevSpec: Verify connection",
        "category": "DevSpec"
      },
      {
        "command": "devspec.done",
        "title": "DevSpec: Log completed work",
        "category": "DevSpec"
      },
      {
        "command": "devspec.help",
        "title": "DevSpec: Help",
        "category": "DevSpec"
      },
      {
        "command": "devspec.link",
        "title": "DevSpec: Link commit to item",
        "category": "DevSpec"
      },
      {
        "command": "devspec.commit",
        "title": "DevSpec: Commit with tracking tag",
        "category": "DevSpec"
      },
      {
        "command": "devspec.autopilot.process",
        "title": "DevSpec Autopilot: Process next staged item",
        "category": "DevSpec"
      },
      {
        "command": "devspec.autopilot.status",
        "title": "DevSpec Autopilot: Show status",
        "category": "DevSpec"
      },
      {
        "command": "devspec.autopilot.history",
        "title": "DevSpec Autopilot: Show history",
        "category": "DevSpec"
      },
      {
        "command": "devspec.setToken",
        "title": "DevSpec: Set MCP token",
        "category": "DevSpec"
      },
      {
        "command": "devspec.registerMcpServer",
        "title": "DevSpec: Register MCP server in Cursor config",
        "category": "DevSpec"
      },
      {
        "command": "devspec.installProjectRules",
        "title": "DevSpec: Install rules",
        "category": "DevSpec"
      },
      {
        "command": "devspec.installRemoteControlHooks",
        "title": "DevSpec: Install remote-control mirror hooks",
        "category": "DevSpec"
      },
      {
        "command": "devspec.forgetRepoFolder",
        "title": "DevSpec: Manage repo folder mappings",
        "category": "DevSpec"
      },
      {
        "command": "devspec.installProtocolHandler",
        "title": "DevSpec: Install protocol handler",
        "category": "DevSpec"
      },
      {
        "command": "devspec.installOpenBridge",
        "title": "DevSpec: Install handoff handler",
        "category": "DevSpec"
      },
      {
        "command": "devspec.startOpenBridge",
        "title": "DevSpec: Start handoff handler",
        "category": "DevSpec"
      }
    ],
    "configuration": {
      "title": "DevSpec",
      "properties": {
        "devspec.apiUrl": {
          "type": "string",
          "default": "",
          "description": "Base URL of the DevSpec API. Set during onboarding (e.g. https://staging.devspec.ai). Leave empty to be prompted on first connect."
        },
        "devspec.mcpToken": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "DevSpec MCP token (starts with `dvs_`). Generate one at **You → Connections** in the DevSpec UI. Stored per-machine."
        },
        "devspec.autoInstallRules": {
          "type": "string",
          "enum": ["prompt", "always", "never"],
          "default": "always",
          "enumDescriptions": [
            "Ask once per workspace when MCP is configured",
            "Install `.cursor/rules/devspec.mdc` automatically in git repos",
            "Never offer or install project rules"
          ],
          "description": "How the extension installs DevSpec agent rules into the workspace."
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --target=node18 --external:vscode --outfile=dist/extension.js",
    "watch": "npm run build -- --watch",
    "typecheck": "tsc --noEmit",
    "sync": "node scripts/sync-from-claude.mjs",
    "package": "npm run build && node scripts/build-handler-exe.mjs && vsce package --out devspec-autopilot.vsix",
    "open-bridge": "node scripts/open-bridge.mjs",
    "open-handler:install": "node scripts/open-handler.mjs --install",
    "open-bridge:install": "node scripts/open-handler.mjs --install",
    "handler:build-exe": "node scripts/build-handler-exe.mjs",
    "publish": "npm run build && vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.21.0",
    "typescript": "^5.4.0"
  }
}
